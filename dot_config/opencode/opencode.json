{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "references": {
    "uds-core": {
      "repository": "defenseunicorns/uds-core",
      "branch": "main",
      "description": "Use for UDS Core implementation and behavior"
    },
    "zarf": {
      "repository": "zarf-dev/zarf",
      "branch": "main",
      "description": "Use for Zarf implementation and behavior"
    },
    "uds-cli": {
      "repository": "defenseunicorns/uds-cli",
      "branch": "main",
      "description": "Use for the existing UDS CLI implementation and behavior"
    },
    "uds-common": {
      "repository": "defenseunicorns/uds-common",
      "branch": "main",
      "description": "Use for shared UDS implementation and utilities"
    },
    "pkg": {
      "repository": "https://github.com/defenseunicorns/pkg",
      "branch": "main",
      "description": "Use for Defense Unicorns shared Go packages"
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "*;*": "ask",
      "*&&*": "ask",
      "*||*": "ask",
      "*|*": "ask",
      "*&*": "ask",
      "*>*": "ask",
      "*<*": "ask",
      "*`*": "ask",
      "*$(*": "ask",
      "*\n*": "ask",
      "*--output*": "ask",
      "*--ext-diff*": "ask",
      "*--textconv*": "ask",
      "rm": "ask",
      "rm *": "ask",
      "rm -rf *": "deny"
    },
    "edit": {
      "*": "ask",
      "~/.local/share/opencode/repos/**": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "task": {
      "*": "ask",
      "explore": "allow"
    },
    "mcp_*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.tfstate": "ask",
      "*.tfstate.*": "ask",
      "*.tfvars": "ask",
      "*.tfvars.json": "ask",
      "*.pem": "ask",
      "*.key": "ask"
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "external_directory": {
      "*": "ask",
      "~/.local/share/opencode/repos/**": "allow"
    },
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "reasoningSummary": "concise"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "reasoningSummary": "detailed"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",
      "reasoningSummary": "concise"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "permission": {
        "edit": "deny"
      }
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "reasoningSummary": "concise",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "plugin": [
    "./plugins/crit.ts"
  ]
}
