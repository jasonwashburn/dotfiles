{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "rm *": "deny",
      "rm -rf *": "deny"
    },
    "edit": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "task": "ask",
    "mcp_*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "reasoningSummary": "concise"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "reasoningSummary": "detailed"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low",
      "reasoningSummary": "concise"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "textVerbosity": "low",
      "reasoningSummary": "concise"
    }
  },
  "plugin": [
    "./plugins/crit.ts"
  ]
}
